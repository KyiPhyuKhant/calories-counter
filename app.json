{
  "expo": {
    "name": "CalNote",
    "slug": "calories-counter",
    "version": "0.1.0",
    "icon": "./assets/healthy-bowl-logo.png",
    "backgroundColor": "#FAFAF7",
    "scheme": "calories-counter",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kyijuly.calnote",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fbb3b677-a781-4354-bd56-db5a8a814f08"
      }
    },
    "owner": "kyi-july",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/fbb3b677-a781-4354-bd56-db5a8a814f08"
    },
    "android": {}
  }
}

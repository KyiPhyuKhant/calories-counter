{
  "expo": {
    "name": "Calorie Counter",
    "slug": "calories-counter",
    "version": "0.1.0",
    "scheme": "calories-counter",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "supportsTablet": true
    },
    "plugins": [
      "expo-router",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}

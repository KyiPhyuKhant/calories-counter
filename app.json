{
  "expo": {
    "name": "CalNote",
    "slug": "calories-counter",
    "version": "0.1.0",
    "icon": "./assets/healthy-bowl-logo.png",
    "backgroundColor": "#FAFAF7",
    "scheme": "calories-counter",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "supportsTablet": true
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
